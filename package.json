{
	"name": "catty",
	"version": "0.6.0",
	"type": "module",
	"private": true,
	"bin": {
		"catty": "./dist/catty"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build": "bun build src/index.ts --target bun --outdir dist --external '@node-llama-cpp/*'",
		"build:binary": "bun build src/index.ts ./src/extensions/codemode/worker.ts --compile --outfile dist/catty --external '@node-llama-cpp/*'",
		"release:darwin-arm64": "bun build src/index.ts ./src/extensions/codemode/worker.ts --compile --target bun-darwin-arm64 --outfile dist/catty-darwin-arm64 --external '@node-llama-cpp/*'",
		"release:darwin-x64": "bun build src/index.ts ./src/extensions/codemode/worker.ts --compile --target bun-darwin-x64 --outfile dist/catty-darwin-x64 --external '@node-llama-cpp/*'",
		"release:linux-x64": "bun build src/index.ts ./src/extensions/codemode/worker.ts --compile --target bun-linux-x64 --outfile dist/catty-linux-x64 --external '@node-llama-cpp/*'",
		"release": "bun run release:darwin-arm64 && bun run release:darwin-x64 && bun run release:linux-x64"
	},
	"dependencies": {
		"@buape/carbon": "^0.17.0",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@earendil-works/pi-server": "^1.1.0",
		"@tobilu/qmd": "^2.8.3",
		"quickjs-wasi": "3.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.3",
		"typescript": "^7.0.2"
	}
}
